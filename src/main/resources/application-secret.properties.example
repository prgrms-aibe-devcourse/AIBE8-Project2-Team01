# 이 파일을 복사해서 application-secret.properties 로 이름을 바꾼 뒤 값을 채운다
# 실제 값은 팀 채널 고정 메시지에서 확인한다 (git에 올리지 않는다)

# JWT 서명 키: 32바이트 이상 (생성: openssl rand -base64 32)
jwt.secret=

# 토스 테스트 시크릿 키 (결제 구현 시)
toss.secret-key=

# Supabase Storage (service_role 키는 서버에서만 사용, 프론트·git에 절대 넣지 않는다)
supabase.url=
supabase.service-key=
supabase.bucket.public=public-files
supabase.bucket.private=private-files
